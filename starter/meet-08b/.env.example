# Salin connection string PostgreSQL dari dashboard Supabase > Connect.
# Pilih Session pooler (port 5432) jika jaringan lokal hanya mendukung IPv4.
# Ganti placeholder; URL-encode karakter khusus pada password.
# Dibaca otomatis dari folder kerja; tidak perlu source/export di terminal.
DATABASE_URL='postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require'
ADDR='127.0.0.1:8080'
